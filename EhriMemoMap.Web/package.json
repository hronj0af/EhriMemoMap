{
  "name": "ehrimemomap-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/resx-to-json.mjs && node scripts/sync-static.mjs",
    "i18n": "node scripts/resx-to-json.mjs",
    "predev": "npm run prepare-assets",
    "dev": "vite",
    "prebuild": "npm run prepare-assets",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet-arrowheads": "^1.4.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "postcss-preset-env": "^11.6.2",
    "purgecss": "^9.1.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
