@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "detail")]
    public string? Detail { get; set; }

    private string[] Cities = Array.Empty<string>();
    private bool ShowingDetail = false;
    private string DetailTitle = "";
    private string DetailContent = "";

    protected override async Task OnInitializedAsync()
    {
        Cities = configuration.GetSection("App:Cities").Get<string[]>() ?? Array.Empty<string>();
        UpdateDetailFromParameter();
        await MapService.Destroy();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("resetPageElementHeight");
    }

    protected override void OnParametersSet()
    {
        UpdateDetailFromParameter();
    }

    private void UpdateDetailFromParameter()
    {
        // [SupplyParameterFromQuery] works for in-app navigation, but on a full WASM
        // page reload it may not be set yet — fall back to manual URL parsing in that case.
        string? rawDetail = Detail;
        if (string.IsNullOrWhiteSpace(rawDetail))
        {
            try
            {
                var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
                rawDetail = System.Web.HttpUtility.ParseQueryString(uri.Query)["detail"];
            }
            catch { }
        }

        var cleanDetail = string.IsNullOrWhiteSpace(rawDetail) ? null : rawDetail.Trim().ToLowerInvariant();

        if (!string.IsNullOrEmpty(cleanDetail))
        {
            if (cleanDetail == "main")
            {
                DetailTitle = "";
                DetailContent = cl["welcomeText_long"].ToString();
                ShowingDetail = true;
            }
            else if (cleanDetail == "metodiky")
            {
                DetailTitle = "Metodiky pro práci s MemoMap";
                DetailContent = "";
                ShowingDetail = true;
            }
            else
            {
                var cityKey = "city_" + cleanDetail;
                var cityLongKey = "welcomeText_" + cleanDetail + "_long";
                var titleRes = cl[cityKey];
                var contentRes = cl[cityLongKey];
                DetailTitle = titleRes.ResourceNotFound ? cl["city_" + rawDetail].ToString() : titleRes.ToString();
                DetailContent = contentRes.ResourceNotFound ? cl["welcomeText_" + rawDetail + "_long"].ToString() : contentRes.ToString();
                ShowingDetail = true;
            }
        }
        else
        {
            ShowingDetail = false;
            DetailTitle = "";
            DetailContent = "";
        }
    }

    private string TargetLanguage => CultureInfo.CurrentCulture.Name == "cs-CZ" ? "EN" : "CS";

    private async Task ChangeLanguage()
    {
        var targetCulture = CultureInfo.CurrentCulture.Name == "cs-CZ" ? "en-US" : "cs-CZ";
        await JS.InvokeVoidAsync("mapAPI.setBlazorCulture", targetCulture);
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private void ShowWelcomeTextLong() => NavigationManager.NavigateTo("/?detail=main");
    private void ShowMetodiky() => NavigationManager.NavigateTo("/?detail=metodiky");
    private void ShowCityInfo(string city) => NavigationManager.NavigateTo($"/?detail={city}");
    private void HideDetail() => NavigationManager.NavigateTo("/");
}