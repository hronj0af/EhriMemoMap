else
{
    <div class="home-container">

        <h1 class="main-title">@cl["memoMaps"]</h1>

        <div class="intro-text">
            @((MarkupString)cl["welcomeText_short"].ToString())
            <div class="read-more-container" style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <RadzenButton Text="@cl["moreInfo"]" Click="@ShowWelcomeTextLong" class="info-btn" Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Icon="info" />
            </div>
        </div>

        <RadzenRow Gap="1rem">
            @foreach (var city in Cities)
            {
                <RadzenColumn SizeLG="6" SizeSM="12" SizeMD="6">
                    <RadzenCard Style="height:200px;" class="rz-mb-12 rz-mt-4">
                        <div class="city-card" style="@($"background-image: linear-gradient(rgba(255, 255, 255, 0.7) 100%), url('images/welcome_image_{city.ToLower()}.jpg'); background-size: cover; background-position: center;")">
                            <h2 class="city-title" style="cursor:pointer" onclick="@(() => NavigationManager.NavigateTo("/" + city, false))">
                                @cl["city_" + city]
                                <RadzenButton Icon="arrow_forward" Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Style="vertical-align: middle; margin-left: 0.5rem;" />
                            </h2>
                            <p class="city-description">@((MarkupString)cl["welcomeText_" + city + "_short"].ToString())</p>
                            <div class="city-buttons">
                                <RadzenButton Text="@cl["moreInfo"]" Click="@(() => ShowCityInfo(city))" class="info-btn" Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Icon="info" />
                            </div>
                        </div>
                    </RadzenCard>
                </RadzenColumn>
            }
            <RadzenColumn SizeLG="6" SizeSM="12" SizeMD="6">
                <RadzenCard style="height:200px" class="rz-mb-12 rz-mt-4">
                    <div class="city-card" style="@($"background-image: linear-gradient(rgba(255, 230, 227, 0.75) 100%), url('images/welcome_image_metodiky.jpg'); background-size: cover; background-position: center;")">
                        <h2 class="city-title" style="cursor:pointer" onclick="@ShowMetodiky">
                            @cl["metodiky"]
                            <RadzenButton Icon="arrow_forward" Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Style="vertical-align: middle; margin-left: 0.5rem;" />
                        </h2>
                        <p class="city-description">@cl["metodiky_card_desc"]</p>
                    </div>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "detail")]
    public string? Detail { get; set; }

    private string[] Cities = Array.Empty<string>();
    private bool ShowingDetail = false;
    private string DetailTitle = "";
    private string DetailContent = "";

    protected override async Task OnInitializedAsync()
    {
        Cities = configuration.GetSection("App:Cities").Get<string[]>() ?? Array.Empty<string>();
        UpdateDetailFromParameter();
        await MapService.Destroy();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("resetPageElementHeight");
    }

    protected override void OnParametersSet()
    {
        UpdateDetailFromParameter();
    }

    private void UpdateDetailFromParameter()
    {
        // [SupplyParameterFromQuery] works for in-app navigation, but on a full WASM
        // page reload it may not be set yet — fall back to manual URL parsing in that case.
        string? rawDetail = Detail;
        if (string.IsNullOrWhiteSpace(rawDetail))
        {
            try
            {
                var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
                rawDetail = System.Web.HttpUtility.ParseQueryString(uri.Query)["detail"];
            }
            catch { }
        }

        var cleanDetail = string.IsNullOrWhiteSpace(rawDetail) ? null : rawDetail.Trim().ToLowerInvariant();

        if (!string.IsNullOrEmpty(cleanDetail))
        {
            if (cleanDetail == "main")
            {
                DetailTitle = "";
                DetailContent = cl["welcomeText_long"].ToString();
                ShowingDetail = true;
            }
            else if (cleanDetail == "metodiky")
            {
                DetailTitle = cl["metodiky_subtitle"].ToString();
                DetailContent = "";
                ShowingDetail = true;
            }
            else
            {
                var cityKey = "city_" + cleanDetail;
                var cityLongKey = "welcomeText_" + cleanDetail + "_long";
                var titleRes = cl[cityKey];
                var contentRes = cl[cityLongKey];
                DetailTitle = titleRes.ResourceNotFound ? cl["city_" + rawDetail].ToString() : titleRes.ToString();
                DetailContent = contentRes.ResourceNotFound ? cl["welcomeText_" + rawDetail + "_long"].ToString() : contentRes.ToString();
                ShowingDetail = true;
            }
        }
        else
        {
            ShowingDetail = false;
            DetailTitle = "";
            DetailContent = "";
        }
    }

    private string TargetLanguage => CultureInfo.CurrentCulture.Name == "cs-CZ" ? "EN" : "CS";

    private async Task ChangeLanguage()
    {
        var targetCulture = CultureInfo.CurrentCulture.Name == "cs-CZ" ? "en-US" : "cs-CZ";
        await JS.InvokeVoidAsync("mapAPI.setBlazorCulture", targetCulture);
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private void ShowWelcomeTextLong() => NavigationManager.NavigateTo("/?detail=main");
    private void ShowMetodiky() => NavigationManager.NavigateTo("/?detail=metodiky");
    private void ShowCityInfo(string city) => NavigationManager.NavigateTo($"/?detail={city}");
    private void HideDetail() => NavigationManager.NavigateTo("/");
}